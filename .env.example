# Firebase Configuration
# Replace these values with your Firebase project settings from the Firebase Console (Project settings > General > Your apps)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Owner WhatsApp Number for Customer Orders
# Format: Country code followed by phone number (no + or spaces, e.g., 919876543210 for India)
VITE_WHATSAPP_NUMBER=919876543210
